# Copy to .env and fill in. Never commit .env.

# --- Where the KBO extract lives ---------------------------------------------
# The zip you downloaded yourself from https://kbopub.economie.fgov.be/kbo-open-data
# (free registration required; there is no anonymous download).
KBO_ZIP=data/raw/KboOpenData_XXXX_YYYY_MM_Full.zip

# --- Destination --------------------------------------------------------------
# duckdb (default, local file, no account needed) or motherduck.
DESTINATION=duckdb
DUCKDB_PATH=kbo.duckdb

# Only needed when DESTINATION=motherduck. Use a service-account token, not a
# personal one. MotherDuck injects this at runtime inside a Flight.
# MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=kbo

# --- Privacy / publishing knobs ------------------------------------------------
# Aggregate cells below this many entities are suppressed before publishing.
KBO_MIN_CELL_SIZE=5
# Which NACE version the sector mart reads. activity.csv carries several. Default 2025
# (NACE Rev. 2.1, sections A-V); 2008 (Rev. 2, A-U) is still supported.
KBO_NACE_VERSION=2025

# --- Optional: SFTP refresh (needs access granted by kbo-bce-webservice@economie.fgov.be)
# KBO_SFTP_HOST=
# KBO_SFTP_USER=
# KBO_SFTP_PASSWORD=
# KBO_SFTP_DIR=
